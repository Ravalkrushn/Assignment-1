# LOYALTYBOX Backend Environment Configuration Template
# Copy this file to .env and configure real credentials for deployment

PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local Connection URI
MONGODB_URI=mongodb://localhost:27017/loyaltybox

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Client Domain
CLIENT_URL=http://localhost:5173

# Factory Administrator Seed Credentials
ADMIN_EMAIL=admin@factory.io
ADMIN_PASSWORD=AdminSecurePassword123!

# Cryptographic Key for HMAC-SHA256 Code Hashing
CODE_HASH_SECRET=your_keyed_hmac_secret_for_scratch_codes_change_in_production

# Optional Security Limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_REDEMPTION_ATTEMPTS=5
